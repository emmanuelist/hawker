# PayPal REST app (SANDBOX). developer.paypal.com > Apps & Credentials (Sandbox).
# The app must be attached to a US sandbox Business account and have the Invoicing feature enabled.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox buyer used only by local end-to-end scripts (never by the app at runtime).
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=
# Postgres (Neon free tier, pooled connection string). Then once: npm run db:migrate && npm run db:seed
DATABASE_URL=
# AI (free tiers). Primary: Groq. Failover: Gemini (aistudio.google.com).
GROQ_API_KEY=
GEMINI_API_KEY=
# AG Studio licence key (optional: without one Studio shows its watermark).
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=
# Optional: HAWKER_SCHEDULER=off runs a local preview without ending holds (the deployed service owns them).
HAWKER_SCHEDULER=

# Video narration only (M3), never used by the app: ElevenLabs voice "Eric" (cjVigY5qzO86Huf0OWal), eleven_multilingual_v2
ELEVENLABS_API_KEY=
